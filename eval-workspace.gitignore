# Ignore unrecognized generated files by default.
*

# Traverse directories so source and project patterns can match at any depth.
!*/

# Application source and scripts.
!*.ts
!*.tsx
!*.mts
!*.cts
!*.js
!*.mjs
!*.cjs
!*.py
!*.pyi
!*.cs
!*.java
!*.go
!*.sh
!*.ps1
!*.cmd
!*.bat

# Project manifests, configuration, fixtures, and documentation.
!package.json
!tsconfig*.json
!jsconfig*.json
!pyproject.toml
!requirements*.txt
!setup.py
!setup.cfg
!Pipfile
!*.csproj
!*.fsproj
!*.vbproj
!*.sln
!Directory.Build.props
!Directory.Build.targets
!NuGet.config
!pom.xml
!build.gradle
!build.gradle.kts
!settings.gradle
!settings.gradle.kts
!gradle.properties
!go.mod
!go.sum
!*.json
!*.jsonl
!*.yaml
!*.yml
!*.toml
!*.xml
!*.config
!*.props
!*.targets
!*.properties
!*.md
!*.txt
!*.sql
!*.graphql
!*.gql
!.gitignore
!.dockerignore
!.env.example
!Dockerfile
!Makefile

# Always exclude dependencies, compiled output, caches, and runtime artifacts.
node_modules/
.pnpm-store/
.npm/
dist/
build/
coverage/
.nyc_output/
.cache/
.parcel-cache/
.turbo/
.data/
tmp/
temp/
logs/
bin/
obj/
target/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.class
*.jar
*.log
*.tsbuildinfo
*.sqlite
*.sqlite3
*.db
package-lock.json
pnpm-lock.yaml
yarn.lock
