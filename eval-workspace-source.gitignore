# Ignore unrecognized generated files by default.
*

# Traverse directories so source and project patterns can match at any depth.
!*/

# TypeScript and JavaScript source, tests, and configuration.
!*.ts
!*.tsx
!*.mts
!*.cts
!*.js
!*.mjs
!*.cjs

# Project manifests, structured fixtures, and documentation.
!package.json
!tsconfig*.json
!*.json
!*.jsonl
!*.yaml
!*.yml
!*.toml
!*.md
!*.sql
!*.graphql
!*.gql
!.gitignore
!.dockerignore
!Dockerfile

# Always exclude dependencies, compiled output, caches, and runtime artifacts.
node_modules/
.pnpm-store/
.npm/
dist/
build/
coverage/
.nyc_output/
.cache/
.parcel-cache/
.turbo/
.data/
tmp/
temp/
logs/
bin/
obj/
target/
.venv/
venv/
__pycache__/
*.log
*.tsbuildinfo
*.sqlite
*.sqlite3
*.db
package-lock.json
pnpm-lock.yaml
yarn.lock
