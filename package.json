{
  "name": "azure-skill-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "pwsh -NoProfile -File scripts/bootstrap-dependencies.ps1",
    "lint:evals": "vally lint --eval-spec scenarios --strict",
    "test": "node --test && python -m compileall -q scenarios && python -m ruff check scenarios && pnpm test:golden",
    "test:oracle": "node scripts/validate-golden-oracles.mjs",
    "test:oracle:foundry": "node scripts/validate-golden-oracles.mjs --service foundry",
    "test:selection": "node --test scripts/run-evaluations.test.mjs",
    "test:golden": "pwsh -NoProfile -File scripts/validate-golden-apps.ps1",
    "experiment": "pnpm experiment:python",
    "experiment:python": "vally experiment run experiments/python/experiment.yaml --output-dir reports",
    "experiment:dotnet": "vally experiment run experiments/dotnet/experiment.yaml --output-dir reports",
    "experiment:go": "vally experiment run experiments/go/experiment.yaml --output-dir reports",
    "experiment:java": "vally experiment run experiments/java/experiment.yaml --output-dir reports",
    "experiment:typescript": "vally experiment run experiments/typescript/experiment.yaml --output-dir reports"
  },
  "devDependencies": {
    "@github/copilot": "1.0.71",
    "@github/copilot-sdk": "1.0.7",
    "@microsoft/vally-cli": "0.15.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.0"
}
