    "demo": "npm run build && npm start"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/identity": "4.11.1",
    "@azure/keyvault-keys": "4.10.0",
    "@azure/storage-blob": "12.28.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
